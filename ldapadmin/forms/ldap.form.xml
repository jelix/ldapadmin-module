<?xml version="1.0" encoding="utf-8"?>
<form xmlns="http://jelix.org/ns/forms/1.1">

    <!-- connection -->

    <input ref="ldap_host" required="true" size="40">
       <label locale="ldapadmin~main.form.ldap_host"/>
    </input>

    <input ref="ldap_port" type="integer" required="true" defaultvalue="389"  size="5">
       <label locale="ldapadmin~main.form.ldap_port"/>
    </input>

    <menulist ref="ldap_tls">
        <label locale="ldapadmin~main.form.ldap_tls"/>
        <emptyitem locale="ldapadmin~main.form.ldap_tls.none"/>
        <item value="starttls" locale="ldapadmin~main.form.ldap_tls.starttls" />
        <item value="ldaps" locale="ldapadmin~main.form.ldap_tls.ldaps" />
    </menulist>

    <input ref="ldap_admin_dn" size="60">
       <label locale="ldapadmin~main.form.ldap_admin_dn"/>
       <help locale="ldapadmin~main.form.ldap_admin_dn.help"/>
    </input>

    <secret ref="ldap_admin_password">
       <label locale="ldapadmin~main.form.ldap_admin_password"/>
    </secret>

    <!-- mapping -->

    <input ref="searchUserBaseDN" required="true" size="60">
       <label locale="ldapadmin~main.form.searchUserBaseDN"/>
    </input>

    <input ref="bindAttribute" required="true" defaultvalue="dn" size="30">
       <label locale="ldapadmin~main.form.bindAttribute"/>
       <help locale="ldapadmin~main.form.bindAttribute.help"/>
    </input>

    <!-- searchUserFilter[], searchAttributes mapping and extra ldap attributes
         are repeatable/dynamic: jForms has no working repeat control, so they
         are rendered as plain HTML inputs directly in config.tpl and handled
         manually in the controller. -->

    <!-- groups synchronization -->
    <group ref="searchGroupEnabled" withcheckbox="true">
        <label locale="ldapadmin~main.form.searchGroupEnabled"/>

        <input ref="searchGroupFilter" size="60" required="true">
            <label locale="ldapadmin~main.form.searchGroupFilter"/>
            <alert type="required" locale="ldapadmin~main.message.searchGroupFilter.missing"/>
        </input>

        <input ref="searchGroupProperty" required="true">
            <label locale="ldapadmin~main.form.searchGroupProperty"/>
            <alert type="required" locale="ldapadmin~main.message.searchGroupProperty.missing"/>
        </input>

        <input ref="searchGroupBaseDN" size="60" required="true">
            <label locale="ldapadmin~main.form.searchGroupBaseDN"/>
            <alert type="required" locale="ldapadmin~main.message.searchGroupBaseDN.missing"/>
        </input>

        <checkbox ref="searchGroupKeepUserInDefaultGroups" defaultvalue="true">
            <label locale="ldapadmin~main.form.searchGroupKeepUserInDefaultGroups"/>
        </checkbox>
    </group>

    <submit ref="_submit">
        <label locale="ldapadmin~main.form.submit"/>
    </submit>
</form>
